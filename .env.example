# Local Keycloak console login (master realm). The init script in keycloak/setup.py
# also creates the app users admin / password and fieldagent / password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=password

# Browser-visible Keycloak URL and the form builder origins allowed to log in
# (comma separated).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ICPH_APP_URLS=http://localhost:5173

# Form builder database (local development defaults).
POSTGRES_DB=icph
POSTGRES_USER=icph
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Set these to the host account that owns the MetaForm data folders.
ICPH_UID=1000
ICPH_GID=1000

# Normally leave blank: the app calls port 8787 when opened on an explicit port,
# and /api on its own origin behind a reverse proxy. Set only if the API is elsewhere.
VITE_FORM_BUILDER_API=
