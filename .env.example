# Replace this placeholder with a private random secret of at least 16 characters.
ICPH_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# Set these to the host account that owns output/ and the MetaForm data folders.
ICPH_UID=1000
ICPH_GID=1000

# Normally leave blank. For a TLS reverse proxy, use its externally reachable API URL.
VITE_FORM_BUILDER_API=
