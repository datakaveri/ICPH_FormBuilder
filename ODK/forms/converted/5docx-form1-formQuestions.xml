<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>ICPH Doc 5 Form 1 - Enrolment and Personal Details</h:title><model odk:xforms-version="1.0.0"><instance><data id="icph_doc5_form1"><AA01/><AA02/><A0/><A1/><A2a/><A2b/><A2c/><A3a/><A3b/><A4/><A5/><A6/><A7/><A8/><B1/><B2/><B3a/><B3b/><B3c/><B4a/><B4b/><B4c/><B4d/><meta><instanceID/><instanceName/></meta></data></instance><instance id="yes_no"><root><item><name>0</name><label>No</label></item><item><name>1</name><label>Yes</label></item></root></instance><instance id="phone_owner"><root><item><name>1</name><label>My own phone</label></item><item><name>2</name><label>My husband's phone</label></item><item><name>3</name><label>My parent's phone</label></item><item><name>4</name><label>Other, specify</label></item></root></instance><bind nodeset="/data/AA01" type="string" required="true()"/><bind nodeset="/data/AA02" type="dateTime" required="true()" readonly="true()"/><setvalue ref="/data/AA02" event="odk-instance-first-load" value="now()"/><bind nodeset="/data/A0" type="string" required="true()"/><bind nodeset="/data/A1" type="string" required="true()"/><bind nodeset="/data/A2a" type="date" required="true()" relevant=" /data/A1  = '1'"/><bind nodeset="/data/A2b" type="int" required="true()" relevant=" /data/A1  = '1'" constraint=". &gt;= 10 and . &lt;= 75" jr:constraintMsg="Age must be between 10 and 75 years."/><bind nodeset="/data/A2c" type="string" relevant=" /data/A1  = '1'" calculate="if( /data/A2a  != '' and  /data/A2a  != date('1111-11-11'), if(int((decimal-date-time(today()) - decimal-date-time( /data/A2a )) div 365.25) &gt;= 18, '1', '0'), if( /data/A2b  &gt;= 18, '1', '0'))" readonly="true()"/><bind nodeset="/data/A3a" type="date" required="true()" relevant=" /data/A1  = '1'"/><bind nodeset="/data/A3b" type="string" relevant=" /data/A1  = '1'" calculate="if( /data/A3a  != '', if((decimal-date-time(today()) - decimal-date-time( /data/A3a )) &lt; 140, '1', '0'), '')" readonly="true()"/><bind nodeset="/data/A4" type="string" required="true()" relevant=" /data/A1  = '1'"/><bind nodeset="/data/A5" type="string" required="true()" relevant=" /data/A1  = '1'"/><bind nodeset="/data/A6" type="string" relevant=" /data/A1  = '1'" calculate="if( /data/A2c  = '1' and  /data/A3b  = '1' and  /data/A4  = '1' and  /data/A5  = '1', '1', '0')" readonly="true()"/><bind nodeset="/data/A7" type="string" required="true()" relevant=" /data/A1  = '1' and  /data/A6  = '1'"/><bind nodeset="/data/A8" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B1" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B2" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B3a" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B3b" type="string" required="true()" relevant=" /data/A7  = '1'" constraint=". =  /data/B3a " jr:constraintMsg="Telephone number must match B3a."/><bind nodeset="/data/B3c" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B4a" type="string" required="true()" relevant=" /data/A7  = '1'"/><bind nodeset="/data/B4b" type="string" required="true()" relevant=" /data/A7  = '1' and  /data/B4a  = '1'"/><bind nodeset="/data/B4c" type="string" required="true()" relevant=" /data/A7  = '1' and  /data/B4a  = '1'" constraint=". =  /data/B4b " jr:constraintMsg="Telephone number must match B4b."/><bind nodeset="/data/B4d" type="string" required="true()" relevant=" /data/A7  = '1' and  /data/B4a  = '1'"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/A8 "/></model></h:head><h:body><input ref="/data/AA01"><label>Device ID</label></input><input ref="/data/AA02"><label>Visit date and time (please check that this is correct)</label><hint>Format: Automatically displayed dd-mm-yyyy hh:mm:ss</hint></input><input ref="/data/A0"><label>Screening ID</label><hint>Format: Alphanumeric, AAA0000</hint></input><select1 ref="/data/A1" appearance="columns"><label>Are you pregnant?</label><hint>If A1==0, end the form and thank the participant for their time.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/A2a"><label>What is your date of birth?</label><hint>Enter 11-11-1111 if not known. Format: dd-mm-yyyy</hint></input><input ref="/data/A2b"><label>What is your age?</label><hint>If A2a=11-11-1111. Format: Numeric, years, range 10-75</hint></input><select1 ref="/data/A2c" appearance="columns"><label>Is the individual aged 18 years or older?</label><hint>Calculated automatically from date of birth, or age if date of birth is unknown.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/A3a"><label>When did your last menstrual period start?</label><hint>Format: dd-mm-yyyy</hint></input><select1 ref="/data/A3b" appearance="columns"><label>Is the individual &lt;20 weeks gestational age by last menstrual period?</label><hint>Calculated automatically from last menstrual period start date.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/A4" appearance="columns"><label>Are you intending to deliver at the study hospital?</label><hint>Replace "study hospital" with the site name if this form is customized for one hospital.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/A5" appearance="columns"><label>Do you reside within 5km of the hospital?</label><hint>Interviewer may prompt for location in case required to ascertain distance.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/A6" appearance="columns"><label>Is the individual eligible to participate?</label><hint>Calculated automatically from age, gestational age, delivery intention, and residence distance.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/A7" appearance="columns"><label>Did the individual provide informed consent to participate?</label><hint>If 0, thank the participant for their time and close the form. If 1, proceed.</hint><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/A8"><label>Participant study ID assigned</label><hint>Automatically done. Assign if A7==1. Format: Alphanumeric, AAA00000</hint></input><input ref="/data/B1"><label>What is your name?</label></input><input ref="/data/B2"><label>What is your address in Chennai?</label></input><input ref="/data/B3a" appearance="numbers"><label>Please can you provide us a phone number that we can contact you with?</label><hint>Format: 000000000</hint></input><input ref="/data/B3b" appearance="numbers"><label>Please can you re-state the telephone number so we can check it is accurate?</label><hint>Display error if not equal to B3a. Format: 000000000</hint></input><select1 ref="/data/B3c" appearance="columns"><label>Is this your phone, or someone else's?</label><itemset nodeset="instance('phone_owner')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/B4a" appearance="columns"><label>Is there any other phone number that we can reach you at, if the above phone number does not work for some reason?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/B4b" appearance="numbers"><label>Please provide the alternative phone number that we can contact you with.</label><hint>Format: 000000000</hint></input><input ref="/data/B4c" appearance="numbers"><label>Please re-enter the telephone number provided</label><hint>Display error if not equal to B4b. Format: 000000000</hint></input><select1 ref="/data/B4d" appearance="columns"><label>Is this your phone, or someone else's?</label><itemset nodeset="instance('phone_owner')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></h:body></h:html>