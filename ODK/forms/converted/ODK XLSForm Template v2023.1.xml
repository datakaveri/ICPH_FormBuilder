<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Demo - Presciption claim and coverage info</h:title><model odk:xforms-version="1.0.0"><instance><data id="demo_1" version="20260706234419"><patient_name/><patient_id/><patient_location/><patient_age/><prescription_doc/><insurance_coverage/><insurace_company/><insurance_name/><meta><instanceID/><instanceName/></meta></data></instance><instance id="covered"><root><item><name>yes</name><label>Yes (prescribed medications is covered in insurance)</label></item><item><name>no</name><label>No (prescribed medications are not covered in insurance)</label></item><item><name>unsure</name><label>Not sure (prescribed medications may / may not be covered in insurance)</label></item></root></instance><bind nodeset="/data/patient_name" type="string" required="true()"/><bind nodeset="/data/patient_id" type="int" required="true()" constraint=".&gt;0" jr:constraintMsg="Must be a positive number"/><bind nodeset="/data/patient_location" type="geopoint" required="true()"/><bind nodeset="/data/patient_age" type="int" required="true()" constraint=".&gt;0"/><bind nodeset="/data/prescription_doc" type="binary" required="true()"/><bind nodeset="/data/insurance_coverage" type="string" required="true()"/><bind nodeset="/data/insurace_company" type="string" required="true()"/><bind nodeset="/data/insurance_name" type="string" required="true()" relevant="selected( /data/insurance_coverage , 'yes')"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/patient_id "/></model></h:head><h:body><input ref="/data/patient_name"><label>What is the patient's name?</lab