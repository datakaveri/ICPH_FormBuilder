# Environments
.venv/
env/
venv/
ENV/

# Python caching
__pycache__/
*.py[cod]
*$py.class
*.so

# React build artifacts
frontend/node_modules/
frontend/dist/

# IDEs
.vscode/
.idea/
*.swp
*.swo

